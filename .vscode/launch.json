{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File (Root Anchor)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "justMyCode": false,
        }
    ]
}
