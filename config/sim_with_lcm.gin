# Default GIN Config File for sim_with_lcm.py

## General Config
object_model_name = "cube"
object_body_name = "cube_body" 
robot_model_name = "robot"
robot_sensor_bodies = ["finger_0", "finger_1", "finger_2"]
sim_dt = 0.001 # seconds
io_dt = 0.001 # time between sim output lcm pubs
densetact_io_dt = 0.0333 # time between densetact lcm pubs

## Random Noise Addition
FingerTipIOSystem.fingerpos_std = 0. # 1e-3
DensetactIOSystem.normal_std = 0.
DensetactIOSystem.force_std = 0. # 1e-2


## Simulation Plant
PlantDiagram.delta_t = %sim_dt # seconds
PlantDiagram.ground_mu = 1.0
PlantDiagram.visualization_file = "meshcat"
PlantDiagram.urdfs = { 
	%object_model_name: @object/get_urdf_asset_contents(), 
	%robot_model_name: @robot/get_urdf_asset_contents()
}

## Base URDF and State Config
#object/get_asset_uri.asset_file_basename = "active/d8_5cm_mmscale.obj"
#object/get_urdf_asset_contents.urdf_file_basename = "active_mesh.urdf.xacro"
#object/get_urdf_asset_contents.mappings = {
#	"mesh": @object/get_asset_uri(),
#	"mass": 0.5,
#	"mu": 0.4,
#	"planar_xz": "false",
#}
object/get_urdf_asset_contents.urdf_file_basename = "contactnets_cube.urdf.xacro"
object/get_urdf_asset_contents.mappings = {
	"length_x": 0.04,
	"length_y": 0.04,
	"length_z": 0.04,
	"mass": 0.5,
	"mu": 0.3,
	"planar_xz": "false",
}
pose/np.random.uniform.low = -0.02
pose/np.random.uniform.high = 0.02
#object_initial_state = [
#	0.7071068, 0.7071068, 0., 0.,
#	0.8923991, 0.2391176, 0.3696438, 0.0990458, # Quat (WXYZ)
#	@pose/np.random.uniform(), @pose/np.random.uniform(), 0.06,     # XYZ
#	0.0, 0.0, 0.0,      # omega_XYZ
#	0.0, 0.0, 0.0,		# dXYZ
#]
object_initial_state = [
	1.0, 0.05, 0.05, 0., # Quat (WXYZ)
	0., 0., 0.06,     # XYZ
	0.0, 0.0, 0.0,      # omega_XYZ
	0.0, 0.0, 0.0,		# dXYZ
]

robot/get_urdf_asset_contents.urdf_file_basename = "spherebot.urdf.xacro"
robot/get_urdf_asset_contents.mappings = {
	"num_fingers": 3,
	"mass": 0.5,
	"mu": 1.0,
	"radius": 0.01,#575, #0.005,
}
robot_initial_state = [
	0., 0.15, 0.15, # Finger 2 q
	0.1, 0., 0.05, # Finger 1 q
	-0.1, 0., 0.05, # Finger 0 q
	0., 0., 0.,   # Finger 2 v
	0., 0., 0.,   # Finger 1 v
	0., 0., 0.,   # Finger 0 v
]

main.init_sim_state = {
	%object_model_name: %object_initial_state,
	%robot_model_name: %robot_initial_state,
}

# Configure Rest of Diagram
PlantDiagram.additional_system_builders = [@sim_diagram_builder]
sim_diagram_builder.lcm_pub_dt = %io_dt
sim_diagram_builder.lcm_densetact_dt = %densetact_io_dt
sim_diagram_builder.lcm_channels = {
	"fingertips_position": "FINGERTIPS_POSITION_SIMULATION", # lcmt_fingertips_position
	"object_state": "CUBE_STATE_SIMULATION", # lcmt_object_state
	"densetact": "DENSETACT_DATA_SIMULATION", # lcmt_densetact_measurement_data
	"fingertips_target": "FINGERTIPS_TARGET_KINEMATICS_SIMULATION", #lcmt_fingertips_target_kinematics
}
sim_diagram_builder.robot_model_name = %robot_model_name
sim_diagram_builder.object_model_name = %object_model_name
sim_diagram_builder.pid_gains = [20.0, 0., 10.0]
FingerTipIOSystem.fingertip_body_names = %robot_sensor_bodies
DensetactIOSystem.densetact_body_names = %robot_sensor_bodies
DensetactIOSystem.normal_scale = 1.0
DensetactIOSystem.friction_scale = 1.0
SetpointFromTargetSystem.traj_time_len = 1.0
SetpointFromTargetSystem.fingertip_body_names = %robot_sensor_bodies