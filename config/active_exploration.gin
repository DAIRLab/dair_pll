# Default GIN Config File for rss_experiment.py

## General Config
robot_radius = 0.01575
robot_buffer_radius = 0.02 # 0.01575 from trifingeredu.urdf + buffer
#workspace_radius = 0.1
workspace_radius = 0.15
robot_model_name = "robot"
object_model_name = "cube"
# The actual Drake body name within the object model
object_body_name = "cube_body" 
fingertip_body_names = ["finger_0", "finger_1"]
default_dt = 0.03333333333333333 # 30 Hz
traj_len_s = 1.0 # s, how long each trajectory is
traj_len_dts = 31 # 30Hz + 1

# CONSTANTS
PI = 3.141592653589793
PI2 = 1.5707963267948966
NPI2 = -1.5707963267948966

## Main Config

# Paralellism in cvxpylayers (added manually)
CvxpyLayer.n_proc=-1
DynamicCvxpyLCQPLayer.solver_args = {
    "solve_method": "Clarabel",
    "n_jobs_forward": -1,
    "n_jobs_backward": 1,
}
#DynamicCvxpyLCQPLayer.solver_args = {
#    "solve_method": "ECOS",
#    "n_jobs_forward": -1,
#    "n_jobs_backward": 1,
#    "max_iters": 1000,
#    "abstol": 1e-4,
#    "reltol": 1e-4,
#    "feastol": 1e-4,
#}

## LCM Trajectory Execution
TrifingerLCMService.fingertip_body_names = %fingertip_body_names
TrifingerLCMService.object_name = %object_model_name
TrifingerLCMService.traj_time_len = %traj_len_s
TrifingerLCMService.lcm_channels = {
	"fingertips_position": "FINGERTIPS_POSITION_SIMULATION", # lcmt_fingertips_position "FINGERTIPS_POSITION"
	"object_state": "CUBE_STATE_SIMULATION", # lcmt_object_state
	"densetact": "DENSETACT_DATA_SIMULATION", # lcmt_densetact_measurement_data
	"fingertips_target": "FINGERTIPS_TARGET_KINEMATICS_SIMULATION", #lcmt_fingertips_target_kinematics
}

## Action Sampling
main.action_params = @ActionWorkspaceParams()
ActionWorkspaceParams.workspace_xy_center = (0., 0.)
ActionWorkspaceParams.workspace_radius = %workspace_radius
ActionWorkspaceParams.robot_radius = %robot_buffer_radius
fixed_240_w/np.array.object = [0.15, 0.15, 0.15]
ActionWorkspaceParams.fixed_240_w = @fixed_240_w/np.array()
ActionWorkspaceParams.approach_radius = 0.1
finger_0_vec/np.array.object = [-1., 0., 0.]
ActionWorkspaceParams.finger_0_vec = @finger_0_vec/np.array()
finger_120_vec/np.array.object = [1., 0., 0.]
ActionWorkspaceParams.finger_120_vec = @finger_120_vec/np.array()
ActionWorkspaceParams.ground_buffer = True
ActionWorkspaceParams.robot_buffer = True

interpolate_sampled_action.fingertip_body_names = %fingertip_body_names
interpolate_sampled_action.traj_len_s = %traj_len_s
interpolate_sampled_action.traj_n_steps = %traj_len_dts

## CEM
ActionCEM.n_samples = 60
ActionCEM.n_dist = 5
ActionCEM.n_iter = 3

## Robot config
robot/get_urdf_asset_contents.urdf_file_basename = "spherebot.urdf.xacro"
robot/get_urdf_asset_contents.mappings = {
	"num_fingers": 2,
	"mu": 1.0,
	"radius": %robot_radius,
}

## Learnable URDF and State Config
TactileSystem.urdfs = {
	%ModelType.CONTROLLABLE: { # Robot Models
		%robot_model_name: @robot/get_urdf_asset_contents(),
	},
	%ModelType.LEARNABLE: { # Learnable Trajectory Models
		%object_model_name: @object_init/get_urdf_asset_contents(), 
	}
}

TactileSystem.hyperparameters = @TactileHyperparameters()
TactileSystem.learnable_body_dict = { 
	%object_body_name: @object_init/LearnableBodySettings()
}

# Initial guesses
object_init/get_urdf_asset_contents.urdf_file_basename = "contactnets_cube.urdf.xacro"
object_init/get_urdf_asset_contents.mappings = {
	"length_x": 0.01, # m
	"length_y": 0.01, # m
	"length_z": 0.01, # m
	"mu": 0.1,
	"planar_xz": "false",
}

TactileSystem.init_learned_state = [
	1.0, 0.0, 0.0, 0.0, # Quat (WXYZ)
	0.02, 0.02, 0.02,     # XYZ
	0.0, 0.0, 0.0,      # omega_XYZ
	0.0, 0.0, 0.0,		# dXYZ
]

# What is learnable
object_init/LearnableBodySettings.inertia_mass = False
object_init/LearnableBodySettings.inertia_com = False
object_init/LearnableBodySettings.inertia_moments_products = False
object_init/LearnableBodySettings.geometry = True
object_init/LearnableBodySettings.friction = False
object_init/LearnableBodySettings.representation = %GeometryRepresentation.PRIMITIVE

# Learning hyperparams
TactileHyperparameters.default_dt = %default_dt
TactileHyperparameters.ctrl_kp = 10.0
TactileHyperparameters.ctrl_kd = 5.0
TactileHyperparameters.loss_fn = %LossFunction.VIMP
TactileHyperparameters.supervise_non_contact_force = True
TactileHyperparameters.rsim_eps = 1e-1

TactileHyperparameters.w_phi_nominal = 0.005  # m, distance where p(contact_measured) drops below CI
TactileHyperparameters.w_phi_ci = 0.05  # Confidence Interval [0,1] for above
TactileHyperparameters.w_normal_var = 0.01519224261 #0.04557672783 #30deg   # cos(radians) [default 10 degrees], variance of cos(normal angle deviation)
TactileHyperparameters.w_force_var = 1e-1  # N, variance of contact force measurement (assume identity covariance)

TactileHyperparameters.w_pen = 1e3
TactileHyperparameters.w_v_pred = 3e3
TactileHyperparameters.w_q_pred = 2e3
TactileHyperparameters.w_comp = 1e1
TactileHyperparameters.w_diss = 5e0
TactileHyperparameters.w_elas = 1e0

# Learning Optimizer
main.optimizer_cls = @Adam
SGD.lr=8e-4
SGD.momentum=2e-4
Adam.lr=2e-3
#Adam.lr = 1e-4
Adam.amsgrad=True
Adam.fused=False

# Geometry Parameters
DeepSupportConvex.depth = 2
DeepSupportConvex.width = 256
DeepSupportConvex.perturbation = 0.4
DeepSupportConvex.n_query = 5

## Exploration Params

## True System (for Metrics)
DrakeSystem.dt = %default_dt # seconds, unnecessary
DrakeSystem.urdfs = { 
	%object_model_name: @object/get_urdf_asset_contents()
}
DrakeSystem.visualization_file = None
object/get_asset_uri.asset_file_basename = "active/d6_4cm_mmscale.obj"
object/get_urdf_asset_contents.urdf_file_basename = "active_mesh.urdf.xacro"
object/get_urdf_asset_contents.mappings = {
	"mesh": @object/get_asset_uri(),
	"mu": 0.1,
	"planar_xz": "false",
}
