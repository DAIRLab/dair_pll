# Default GIN Config File for rss_experiment.py

## General Config
robot_radius = 0.02 # 0.01575 from trifingeredu.urdf + buffer
workspace_radius = 0.15
robot_model_name = "robot"
object_model_name = "cube"
# The actual Drake body name within the object model
object_body_name = "cube_body" 
fingertip_body_names = ["finger_0", "finger_1", "finger_2"]
default_dt = 0.03333333333333333 # 30 Hz
traj_len_s = 2.0 # s, how long each trajectory is

# CONSTANTS
PI = 3.141592653589793
PI2 = 1.5707963267948966
NPI2 = -1.5707963267948966

## Main Config

# Paralellism in cvxpylayers (added manually)
CvxpyLayer.n_proc=-1
DynamicCvxpyLCQPLayer.solver_args = {
    "solve_method": "ECOS",
    "n_jobs_forward": -1,
    "n_jobs_backward": 1,
    "max_iters": 800,
    "abstol": 1e-8,
    "reltol": 1e-8,
    "feastol": 1e-8,
}

## LCM Trajectory Execution
TrifingerLCMService.fingertip_body_names = %fingertip_body_names
TrifingerLCMService.traj_time_len = %traj_len_s
TrifingerLCMService.safe_height = %workspace_radius
TrifingerLCMService.lcm_channels = {
	"fingertips_position": "FINGERTIPS_POSITION_SIMULATION", # lcmt_fingertips_position "FINGERTIPS_POSITION"
	"object_state": "CUBE_STATE_SIMULATION", # lcmt_object_state
	"densetact": "DENSETACT_DATA", # lcmt_densetact_measurement_data
	"fingertips_target": "FINGERTIPS_TARGET_KINEMATICS", #lcmt_fingertips_target_kinematics
}

## Action Sampling
sample_action.params = @ActionLibraryParams()
ActionLibraryParams.workspace_xy_center = (0., 0.)
ActionLibraryParams.workspace_z_rot = 0. # 0.785398163 # pi/4
ActionLibraryParams.workspace_radius = %workspace_radius
ActionLibraryParams.robot_radius = %robot_radius
ActionLibraryParams.fixed_240_w = (0.15, 0.15, 0.15)
ActionLibraryParams.ground_buffer = True
ActionLibraryParams.yplane_buffer = False

## Action Library
xsingle/Action.name = "XSINGLE"
xsingle/Action.posx_start_polar = %PI2
xsingle/Action.posx_start_azimuth = 0.
xsingle/Action.posx_end_radius = 0.
xsingle/Action.posx_end_angle = 0.

xpinch/Action.name = "XPINCH"
xpinch/Action.posx_start_polar = %PI2
xpinch/Action.posx_start_azimuth = 0.
xpinch/Action.posx_end_radius = 0.
xpinch/Action.posx_end_angle = 0.
xpinch/Action.negx_start_polar = %PI2
xpinch/Action.negx_start_azimuth = 0.
xpinch/Action.negx_end_radius = 0.
xpinch/Action.negx_end_angle = 0.

ypinch/Action.name = "YPINCH"
ypinch/Action.posx_start_polar = %PI2
ypinch/Action.posx_start_azimuth = %NPI2
ypinch/Action.posx_end_radius = 0.
ypinch/Action.posx_end_angle = 0.
ypinch/Action.negx_start_polar = %PI2
ypinch/Action.negx_start_azimuth = %PI2
ypinch/Action.negx_end_radius = 0.
ypinch/Action.negx_end_angle = 0.

zsingle/Action.name = "ZSINGLE"
zsingle/Action.posx_start_polar = 0.
zsingle/Action.posx_start_azimuth = 0.
zsingle/Action.posx_end_radius = 0.
zsingle/Action.posx_end_angle = 0.
zsingle/Action.negx_start_polar = %PI2
zsingle/Action.negx_start_azimuth = %PI2
zsingle/Action.negx_end_radius = 1.
zsingle/Action.negx_end_angle = 0.

