main.action_library = %library
interpolate_sampled_action.traj_len_s = %traj_len_s
interpolate_sampled_action.traj_n_steps = 61

## Robot config
robot/get_urdf_asset_contents.urdf_file_basename = "spherebot.urdf.xacro"
robot/get_urdf_asset_contents.mappings = {
	"num_fingers": 2,
	"mu": 1.0,
	"radius": 0.01575,
}

## Learnable URDF and State Config
TactileSystem.urdfs = {
	%ModelType.CONTROLLABLE: { # Robot Models
		%robot_model_name: @robot/get_urdf_asset_contents(),
	},
	%ModelType.LEARNABLE: { # Learnable Trajectory Models
		%object_model_name: @object_init/get_urdf_asset_contents(), 
	}
}

TactileSystem.hyperparameters = @TactileHyperparameters()
TactileSystem.learnable_body_dict = { 
	%object_body_name: @object_init/LearnableBodySettings()
}

# Initial guesses
object_init/get_urdf_asset_contents.urdf_file_basename = "contactnets_cube.urdf.xacro"
object_init/get_urdf_asset_contents.mappings = {
	"length_x": 0.065, # m
	"length_y": 0.065, # m
	"length_z": 0.065, # m
	"mu": 0.1,
	"planar_xz": "false",
}

TactileSystem.init_learned_state = [
	1.0, 0.0, 0.0, 0.0, # Quat (WXYZ)
	0.0, 0.0, 0.0325,     # XYZ
	0.0, 0.0, 0.0,      # omega_XYZ
	0.0, 0.0, 0.0,		# dXYZ
]

# What is learnable
object_init/LearnableBodySettings.inertia_mass = False
object_init/LearnableBodySettings.inertia_com = False
object_init/LearnableBodySettings.inertia_moments_products = False
object_init/LearnableBodySettings.geometry = True
object_init/LearnableBodySettings.friction = False
object_init/LearnableBodySettings.representation = %GeometryRepresentation.PRIMITIVE

# Learning hyperparams
TactileHyperparameters.default_dt = %default_dt
TactileHyperparameters.ctrl_kp = 10.0
TactileHyperparameters.ctrl_kd = 5.0
TactileHyperparameters.loss_fn = %LossFunction.VIMP
TactileHyperparameters.supervise_non_contact_force = True
TactileHyperparameters.rsim_eps = 1e-1

TactileHyperparameters.w_phi_nominal = 0.002  # m, distance where p(contact_measured) drops below CI
TactileHyperparameters.w_phi_ci = 0.05  # Confidence Interval [0,1] for above
TactileHyperparameters.w_normal_var = 0.01519224261  # cos(radians) [default 10 degrees], variance of cos(normal angle deviation)
TactileHyperparameters.w_force_var = 1e-1  # N, variance of contact force measurement (assume identity covariance)

TactileHyperparameters.w_pen = 1e1
TactileHyperparameters.w_v_pred = 1e3
TactileHyperparameters.w_q_pred = 1e1
TactileHyperparameters.w_comp = 1e1
TactileHyperparameters.w_diss = 1e3
TactileHyperparameters.w_elas = 1e0

# Learning Optimizer
main.optimizer_cls = @Adam
SGD.lr=8e-4
SGD.momentum=2e-4
Adam.lr=3e-3
Adam.amsgrad=True
Adam.fused=False

## Exploration Params

## True System (for Metrics)
DrakeSystem.dt = %default_dt # seconds, unnecessary
DrakeSystem.urdfs = { 
	%object_model_name: @object/get_urdf_asset_contents()
}
DrakeSystem.visualization_file = None
object/get_urdf_asset_contents.urdf_file_basename = "contactnets_cube.urdf.xacro"
object/get_urdf_asset_contents.mappings = {
	"length_x": 0.065, # m
	"length_y": 0.065, # m
	"length_z": 0.065, # m
	"mu": 0.1,
	"planar_xz": "false",
}
